{
  "name": "stickman-lab-v3",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "物理火柴人实验室 v3：2026-11-10 架构基线，允许关节锁死/增重/虚拟回正力等非物理辅助",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "probe": "node tools/run.mjs",
    "idle": "node tools/run.mjs probe-idle",
    "authority": "node tools/run.mjs probe-authority",
    "stand": "node tools/run.mjs probe-stand",
    "squat": "node tools/run.mjs _probe-squat-fall",
    "assist": "node tools/run.mjs _probe-assist-monitor"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.14.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.170.0",
    "typescript": "~5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
