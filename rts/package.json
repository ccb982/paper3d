{
  "name": "rts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "guard": "node scripts/arch-guard.mjs",
    "check": "npm run typecheck && npm run guard",
    "smoke": "node scripts/smoke.mjs",
    "probe": "node scripts/probe-rts.mjs",
    "probe:mountain": "node scripts/probe-mountain.mjs",
    "probe:cmd": "node scripts/probe-cmd.mjs",
    "probe:dir": "node scripts/probe-dir.mjs",
    "probe:squad": "node scripts/probe-squad.mjs",
    "probe:slope": "node scripts/probe-slope.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:engine": "esbuild scripts/engine-selftest.ts --bundle --platform=node --format=esm --loader:.wasm=empty --loader:.wasm?url=empty --outfile=scripts/.engine-selftest.mjs && node scripts/.engine-selftest.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.20.0",
    "earcut": "^3.2.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/three": "^0.170.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "~5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
