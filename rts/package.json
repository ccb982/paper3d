{
  "name": "rts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "guard": "node scripts/arch-guard.mjs",
    "check": "npm run typecheck && npm run guard",
    "smoke": "node scripts/smoke.mjs",
    "probe": "node scripts/probe-rts.mjs",
    "probe:mountain": "node scripts/probe-mountain.mjs",
    "probe:cmd": "node scripts/probe-cmd.mjs",
    "probe:dir": "node scripts/probe-dir.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.20.0",
    "earcut": "^3.2.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/three": "^0.170.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "~5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
