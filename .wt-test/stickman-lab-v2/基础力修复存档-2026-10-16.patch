+            engineLimited: true,
+            impulseMax: 0,
+            engineMotor: isEngineMotor,
+            engineJoint: joint,
+            angle: 0, vel: 0, inertia: 0, inertiaLow: 0, axisWorld: new Float64Array(3), anchorWorld: new Float64Array(3),
