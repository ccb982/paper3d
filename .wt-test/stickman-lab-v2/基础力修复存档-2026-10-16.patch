+  /** 有效惯量（折合到该轴；冲量→Δω 的换算） */
+  inertia: number;
+  /** 轴/锚点的世界坐标（每步 updateDofState 刷新；重力补偿与雅可比复用） */
+  axisWorld: Float64Array;
+  anchorWorld: Float64Array;
