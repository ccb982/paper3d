+          //   用 setMass 会让 Rapier 按几何重算惯量 ⇒ 小刚体 1/I 爆炸。
+          .setMassProperties(
+            c.mass,
+            { x: 0, y: c.comY, z: 0 },
+            { x: c.inertiaXY, y: c.inertiaXY, z: c.inertiaZ },
+            { x: 0, y: 0, z: 0, w: 1 },
+          )
+          .setFriction(this.opt.bodyFriction)
+          .setRestitution(0)
+          .setCollisionGroups(GROUPS_SELF);
