{
  "name": "water",
  "category": "fluid",
  "description": "水流/液体：自由表面压力边界 + 表面张力收拢 + 粘度内聚（2026-08 水团攻坚基准）",
  "enableAdvection": true,
  "enablePressure": true,
  "pressureIterations": 100,
  "pressureOmega": 1.7,
  "pressureBoundaryMode": "neumann",
  "enableWarmStart": true,
  "advectionMode": "vector",
  "combineMode": "sub",
  "channels": { "h": true, "s": true, "l": true },
  "viscosity": 20,
  "scalarConfig": {
    "hMultiplier": 0.15,
    "sMultiplier": 0.1,
    "lMultiplier": 0.05,
    "aMultiplier": 0.4,
    "baselineDensity": 0.15,
    "decayRate": 0.02
  },
  "gravity": { "x": 0, "y": 200 },
  "velocityScale": 0.9,
  "maxVelocity": 400,
  "colorBoundaryMode": "clamp",
  "regionWalls": true,
  "levelSetConfig": {
    "enabled": true,
    "reinitInterval": 1,
    "reinitIterations": 6,
    "surfaceTension": 1000000,
    "narrowBandWidth": 5,
    "constrainLiquid": true,
    "outwardDamping": 1,
    "clampAirPhi": true,
    "maxAirPhi": 0,
    "compensateWaterPhi": true,
    "waterCompensationRate": 0.1
  },
  "continuousSources": [
    {
      "enabled": true,
      "position": { "x": 0.5, "y": 0.15 },
      "radius": 0.1,
      "velocity": { "x": 0, "y": 160 },
      "color": [0.15, 0.45, 0.8],
      "density": 0.7,
      "rate": 0.7
    }
  ]
}
