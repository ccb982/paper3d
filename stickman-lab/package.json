{
  "name": "stickman-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "物理火柴人实验室：Rapier 关节骨架 + 进化学习行走/战斗 + 海猫组件贴图（最终作为隐藏 boss 移植回本体）",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "typecheck:gate": "tsc -p tsconfig.gate.json --noEmit",
    "parts": "python tools/build-parts.py",
    "size": "node tools/measure-size.mjs",
    "verify": "node tools/run.mjs verify-core",
    "probe:axisown": "npm run typecheck:gate && node tools/run.mjs probe-axisown",
    "ground": "node tools/run.mjs probe-ground",
    "skin": "node tools/run.mjs probe-skin",
    "stability": "node tools/run.mjs probe-stability",
    "push": "node tools/run.mjs probe-push",
    "push:diag": "node tools/run.mjs probe-push diag 9",
    "capgen": "node tools/run.mjs probe-capgen",
    "spine": "node tools/run.mjs probe-spine",
    "web": "node tools/run.mjs probe-web",
    "stand": "node tools/run.mjs probe-stand",
    "fitdir": "node tools/run.mjs probe-fitdir",
    "balance2": "node tools/run.mjs probe-balance2",
    "authority": "node tools/run.mjs probe-authority",
    "uipanel": "node tools/run-uipanel.mjs",
    "grf": "node tools/run.mjs probe-grf",
    "qp": "node tools/run.mjs probe-qp",
    "readout": "node tools/run.mjs probe-readout",
    "probe:readback": "node tools/run.mjs probe-readback",
    "probe:domain": "node tools/run.mjs probe-domain",
    "probe:calib": "node tools/run.mjs probe-calib"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.14.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.170.0",
    "typescript": "~5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
